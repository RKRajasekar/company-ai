datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  name         String
  email        String   @unique
  passwordHash String
  salt         String
  role         String
  department   String
  designation  String
  team         String   @default("General Workspace")
  managerName  String   @default("N/A")
  status       String   @default("active")
  lastActive   String   @default("Just now")
  joiningDate  String
  phone        String   @default("+1 (555) 019-0000")
  avatar       String   @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80")
  permissions  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
